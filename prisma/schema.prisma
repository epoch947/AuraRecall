generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model PublicEcho {
  id            String         @id @default(uuid())
  color         String         // Semantic color (hex or HSL) — never raw user text
  insight       String         // AI-generated Socratic question
  weather       String         // Weather condition string
  resonances    Int            @default(0) // Community ripple count
  embedding     Json?          // OpenAI text-embedding-3-small vector (1536-dim), nullable for old rows
  authorId      String?        // Anonymous user UUID who shared this echo
  createdAt     DateTime       @default(now())
  conversations Conversation[]

  @@index([createdAt(sort: Desc)])
}

model Conversation {
  id          String    @id @default(uuid())
  echoId      String
  echo        PublicEcho @relation(fields: [echoId], references: [id])
  initiatorId String    // The user sending the whisper
  receiverId  String    // The author of the echo
  status      String    @default("PENDING") // PENDING or ACCEPTED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
